<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>식곤증 타파! 10초 2D 미로 탈출 게임</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.75);
            --primary-color: #38bdf8;
            --accent-color: #f43f5e;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --text-color: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: rgba(255, 255, 255, 0.12);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(56, 189, 248, 0.18) 0%, transparent 35%),
                radial-gradient(circle at 85% 80%, rgba(244, 63, 94, 0.18) 0%, transparent 35%);
        }

        .app-container {
            width: 100%;
            max-width: 520px;
            padding: 20px;
        }

        .card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 28px 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        .title {
            font-size: 2.2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #38bdf8, #f43f5e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 24px;
        }

        .survey-box {
            background: rgba(15, 23, 42, 0.65);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 24px;
            border: 1px solid var(--border-color);
        }

        .survey-label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .level-badge {
            background: var(--primary-color);
            color: #0f172a;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 800;
        }

        .slider {
            width: 100%;
            height: 8px;
            border-radius: 4px;
            background: #334155;
            outline: none;
            -webkit-appearance: none;
            cursor: pointer;
        }

        .slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--primary-color);
            cursor: pointer;
            box-shadow: 0 0 12px var(--primary-color);
        }

        .status-desc {
            margin-top: 12px;
            font-size: 0.88rem;
            color: #e2e8f0;
            font-weight: 500;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 24px;
        }

        .feature-item {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            font-size: 0.8rem;
            color: var(--text-muted);
            text-align: left;
        }

        .feature-item strong {
            display: block;
            color: var(--text-color);
            margin-bottom: 4px;
            font-size: 0.85rem;
        }

        .start-btn {
            width: 100%;
            background: linear-gradient(135deg, #38bdf8, #0284c7);
            color: white;
            border: none;
            padding: 16px;
            border-radius: 16px;
            font-size: 1.1rem;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 8px 24px rgba(56, 189, 248, 0.35);
            transition: all 0.2s ease;
        }

        .start-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(56, 189, 248, 0.5);
        }

        .start-btn:active {
            transform: translateY(0);
        }

        #game-screen {
            display: none;
            flex-direction: column;
            align-items: center;
        }

        .game-header {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .stage-info {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .item-badge {
            font-size: 0.78rem;
            background: rgba(56, 189, 248, 0.15);
            border: 1px solid var(--primary-color);
            padding: 3px 8px;
            border-radius: 8px;
            color: var(--text-color);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .timer-badge {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--accent-color);
            background: rgba(244, 63, 94, 0.12);
            padding: 5px 12px;
            border-radius: 10px;
            border: 1px solid rgba(244, 63, 94, 0.3);
            min-width: 68px;
        }

        .lobby-btn-sm {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .lobby-btn-sm:hover {
            background: rgba(244, 63, 94, 0.2);
            border-color: var(--accent-color);
        }

        .timer-bar-bg {
            width: 100%;
            height: 6px;
            background: #334155;
            border-radius: 3px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .timer-bar-fill {
            height: 100%;
            width: 100%;
            background: linear-gradient(90deg, #38bdf8, #f43f5e);
            transition: width 0.1s linear;
        }

        .canvas-container {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
            border: 2px solid var(--border-color);
            background: #020617;
        }

        canvas {
            display: block;
        }

        .controls-note {
            margin-top: 12px;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .dpad {
            display: grid;
            grid-template-columns: repeat(3, 52px);
            grid-template-rows: repeat(3, 52px);
            gap: 6px;
            margin-top: 16px;
        }

        .dpad-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--border-color);
            color: white;
            border-radius: 12px;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.1s;
        }

        .dpad-btn:active {
            background: var(--primary-color);
            color: #0f172a;
        }

        .modal {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.88);
            backdrop-filter: blur(10px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 2000;
            padding: 20px;
        }

        .modal-card {
            background: #1e293b;
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 24px;
            width: 100%;
            max-width: 420px;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
        }

        .modal-title {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--primary-color);
            margin-bottom: 6px;
        }

        .weapon-options {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin: 18px 0;
        }

        .weapon-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            padding: 12px 16px;
            border-radius: 14px;
            color: white;
            text-align: left;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: all 0.2s;
        }

        .weapon-btn:hover {
            background: rgba(56, 189, 248, 0.18);
            border-color: var(--primary-color);
            transform: translateX(3px);
        }

        .weapon-icon {
            font-size: 1.8rem;
        }

        .result-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.92);
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
            text-align: center;
            z-index: 1000;
        }

        .result-title {
            font-size: 2rem;
            font-weight: 900;
            margin-bottom: 8px;
        }

        .result-title.fail { color: var(--accent-color); }

        .button-group {
            display: flex;
            gap: 10px;
            margin-top: 18px;
        }

        .btn-action {
            background: var(--primary-color);
            color: #0f172a;
            border: none;
            padding: 12px 20px;
            border-radius: 12px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            opacity: 0.9;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border: 1px solid var(--border-color);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
        }
    </style>
</head>
<body>

    <div class="app-container">
        <!-- 메인 로비 화면 -->
        <div class="card" id="home-screen">
            <h1 class="title">식곤증 타파!</h1>
            <p class="subtitle">10초 시간제한 2D 미로 탈출 게임</p>

            <div class="survey-box">
                <div class="survey-label">
                    <span>현재 식곤증 정도</span>
                    <span class="level-badge" id="levelBadge">LV. 5</span>
                </div>
                <input type="range" min="1" max="10" value="5" class="slider" id="drowsinessSlider">
                <p class="status-desc" id="statusDesc">💤 멍한 상태 (미로 크기: 보통)</p>
            </div>

            <div class="feature-grid">
                <div class="feature-item">
                    <strong>⏱️ 10초 타임어택</strong>
                    빠르게 미로를 빠져나가세요.
                </div>
                <div class="feature-item">
                    <strong>👾 스테이지 괴물</strong>
                    스테이지별 괴물 수 증가!
                </div>
                <div class="feature-item">
                    <strong>⚔️ 매판 아이템 선택</strong>
                    이동속도 2배, 공격 무기 획득.
                </div>
                <div class="feature-item">
                    <strong>🎵 폴리포닉 8비트 BGM</strong>
                    신나는 합성 음악으로 졸음 퇴치.
                </div>
            </div>

            <button class="start-btn" id="startBtn">각성 미로 시작하기 ⚡</button>
        </div>

        <!-- 게임 화면 -->
        <div class="card" id="game-screen">
            <div class="game-header">
                <div class="stage-info">
                    <span id="stageText">STAGE 1</span>
                    <span class="item-badge" id="itemBadge">아이템: 없음</span>
                </div>
                <div class="header-actions">
                    <div class="timer-badge" id="timerText">10.0s</div>
                    <button class="lobby-btn-sm" id="headerLobbyBtn">🏠 로비</button>
                </div>
            </div>

            <div class="timer-bar-bg">
                <div class="timer-bar-fill" id="timerBar"></div>
            </div>

            <div class="canvas-container">
                <canvas id="gameCanvas" width="360" height="360"></canvas>
                
                <!-- 결과 레이어 -->
                <div class="result-overlay" id="resultOverlay">
                    <div class="result-title fail" id="resultTitle">GAME OVER</div>
                    <p id="resultDesc" style="color: var(--text-muted); font-size: 0.9rem;"></p>
                    <div class="button-group">
                        <button class="btn-action" id="retryBtn">다시 도전</button>
                        <button class="btn-action btn-secondary" id="resultLobbyBtn">🏠 메인 로비</button>
                    </div>
                </div>
            </div>

            <p class="controls-note">키보드 방향키 / WASD / 화면 버튼 조작</p>

            <div class="dpad">
                <div></div>
                <button class="dpad-btn" id="btnUp">▲</button>
                <div></div>
                <button class="dpad-btn" id="btnLeft">◀</button>
                <button class="dpad-btn" id="btnDown">▼</button>
                <button class="dpad-btn" id="btnRight">▶</button>
            </div>
        </div>
    </div>

    <!-- 아이템 선택 모달 -->
    <div class="modal" id="weaponModal">
        <div class="modal-card">
            <h2 class="modal-title">🎉 STAGE CLEAR!</h2>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 14px;">
                다음 단계를 위해 사용할 아이템을 선택하세요! (매판 새로 설정)
            </p>
            <div class="weapon-options">
                <button class="weapon-btn" data-weapon="speed">
                    <span class="weapon-icon">👟</span>
                    <div>
                        <strong style="display:block;">에너지 드링크 (속도 2배)</strong>
                        <span style="font-size:0.75rem; color:#94a3b8;">방향키 입력 시 2칸씩 순식간에 이동</span>
                    </div>
                </button>
                <button class="weapon-btn" data-weapon="laser">
                    <span class="weapon-icon">⚡</span>
                    <div>
                        <strong style="display:block;">각성 레이저</strong>
                        <span style="font-size:0.75rem; color:#94a3b8;">주변 1칸 이내 괴물 자동 감전 퇴치</span>
                    </div>
                </button>
                <button class="weapon-btn" data-weapon="hammer">
                    <span class="weapon-icon">🔨</span>
                    <div>
                        <strong style="display:block;">잠깨기 해머</strong>
                        <span style="font-size:0.75rem; color:#94a3b8;">이동 시 강력한 충격파로 괴물 파괴</span>
                    </div>
                </button>
                <button class="weapon-btn" data-weapon="bomb">
                    <span class="weapon-icon">💣</span>
                    <div>
                        <strong style="display:block;">알람 폭탄</strong>
                        <span style="font-size:0.75rem; color:#94a3b8;">시작 직후 주변 괴물 일괄 폭파</span>
                    </div>
                </button>
            </div>
            <button class="btn-action btn-secondary" id="modalLobbyBtn" style="width:100%; margin-top:6px;">🏠 메인 로비로 돌아가기</button>
        </div>
    </div>

    <script>
        let audioCtx = null;
        let bgmTimer = null;
        let bgmStep = 0;

        // Polyphonic 8-Bit Chiptune Sequences (Melody + Bass + Chord)
        const bgmMelody = [
            523.25, 659.25, 783.99, 1046.50, 783.99, 659.25, 587.33, 698.46,
            880.00, 1174.66, 880.00, 698.46, 659.25, 783.99, 987.77, 1318.51
        ];

        const bgmBass = [
            130.81, 130.81, 164.81, 164.81, 146.83, 146.83, 174.61, 174.61,
            164.81, 164.81, 196.00, 196.00, 130.81, 130.81, 196.00, 196.00
        ];

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function playSound(type) {
            if (!audioCtx) return;
            try {
                const now = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (type === 'ui') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(520, now);
                    gain.gain.setValueAtTime(0.06, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
                    osc.start(now);
                    osc.stop(now + 0.06);
                } else if (type === 'move') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(340, now);
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
                    osc.start(now);
                    osc.stop(now + 0.05);
                } else if (type === 'clear') {
                    osc.type = 'square';
                    osc.frequency.setValueAtTime(523.25, now);
                    osc.frequency.setValueAtTime(659.25, now + 0.08);
                    osc.frequency.setValueAtTime(783.99, now + 0.16);
                    osc.frequency.setValueAtTime(1046.50, now + 0.24);
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);
                    osc.start(now);
                    osc.stop(now + 0.5);
                } else if (type === 'alarm') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(880, now);
                    osc.frequency.setValueAtTime(440, now + 0.12);
                    osc.frequency.setValueAtTime(880, now + 0.24);
                    gain.gain.setValueAtTime(0.25, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
                    osc.start(now);
                    osc.stop(now + 0.4);
                } else if (type === 'item') {
                    osc.type = 'square';
                    osc.frequency.setValueAtTime(250, now);
                    osc.frequency.exponentialRampToValueAtTime(850, now + 0.18);
                    gain.gain.setValueAtTime(0.18, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
                    osc.start(now);
                    osc.stop(now + 0.18);
                }
            } catch(e) { console.error(e); }
        }

        function startBGM() {
            stopBGM();
            if (!audioCtx) return;
            bgmStep = 0;
            bgmTimer = setInterval(() => {
                try {
                    const now = audioCtx.currentTime;

                    // Lead Melody Oscillator
                    const melOsc = audioCtx.createOscillator();
                    const melGain = audioCtx.createGain();
                    melOsc.type = 'square';
                    melOsc.frequency.setValueAtTime(bgmMelody[bgmStep % bgmMelody.length], now);
                    melGain.gain.setValueAtTime(0.025, now);
                    melGain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
                    melOsc.connect(melGain);
                    melGain.connect(audioCtx.destination);
                    melOsc.start(now);
                    melOsc.stop(now + 0.12);

                    // Bassline Oscillator
                    const bassOsc = audioCtx.createOscillator();
                    const bassGain = audioCtx.createGain();
                    bassOsc.type = 'triangle';
                    bassOsc.frequency.setValueAtTime(bgmBass[bgmStep % bgmBass.length], now);
                    bassGain.gain.setValueAtTime(0.04, now);
                    bassGain.gain.exponentialRampToValueAtTime(0.001, now + 0.14);
                    bassOsc.connect(bassGain);
                    bassGain.connect(audioCtx.destination);
                    bassOsc.start(now);
                    bassOsc.stop(now + 0.14);

                    bgmStep++;
                } catch(e) {}
            }, 140);
        }

        function stopBGM() {
            if (bgmTimer) {
                clearInterval(bgmTimer);
                bgmTimer = null;
            }
        }

        const slider = document.getElementById('drowsinessSlider');
        const badge = document.getElementById('levelBadge');
        const desc = document.getElementById('statusDesc');

        const descriptions = [
            "😴 미세한 졸음 (미로 크기: 매우 작음)",
            "😴 미세한 졸음 (미로 크기: 매우 작음)",
            "🥱 약간 피곤함 (미로 크기: 작음)",
            "🥱 약간 피곤함 (미로 크기: 작음)",
            "💤 멍한 상태 (미로 크기: 보통)",
            "💤 멍한 상태 (미로 크기: 보통)",
            "😱 잠이 쏟아짐 (미로 크기: 큼)",
            "😱 잠이 쏟아짐 (미로 크기: 큼)",
            "🚨 초강력 잠깨기 필요 (미로 크기: 매우 큼)",
            "🚨 초강력 잠깨기 필요 (미로 크기: 극대)"
        ];

        slider.addEventListener('input', (e) => {
            playSound('ui');
            const val = e.target.value;
            badge.innerText = `LV. ${val}`;
            desc.innerText = descriptions[val - 1];
        });

        let currentStage = 1;
        let drowsinessLevel = 5;
        let gridCols = 7;
        let gridRows = 7;
        let maze = [];
        let player = { x: 0, y: 0 };
        let goal = { x: 0, y: 0 };
        let monsters = [];
        let currentItem = null;

        let visualEffects = [];
        let timeLeft = 10.0;
        let gameTimer = null;
        let isPlaying = false;

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        let cellSize = 40;

        // --- Lobby Navigation (로비로 돌아가기) ---
        function returnToLobby() {
            playSound('ui');
            isPlaying = false;
            stopBGM();
            clearInterval(gameTimer);

            currentStage = 1;
            currentItem = null;

            document.getElementById('weaponModal').style.display = 'none';
            document.getElementById('resultOverlay').style.display = 'none';
            document.getElementById('game-screen').style.display = 'none';
            document.getElementById('home-screen').style.display = 'block';
        }

        document.getElementById('headerLobbyBtn').addEventListener('click', returnToLobby);
        document.getElementById('resultLobbyBtn').addEventListener('click', returnToLobby);
        document.getElementById('modalLobbyBtn').addEventListener('click', returnToLobby);

        document.getElementById('startBtn').addEventListener('click', () => {
            initAudio();
            playSound('ui');
            drowsinessLevel = parseInt(slider.value);
            currentStage = 1;
            currentItem = null;

            document.getElementById('home-screen').style.display = 'none';
            document.getElementById('game-screen').style.display = 'flex';

            startStage();
        });

        function startStage() {
            startBGM();

            visualEffects = [];
            updateItemBadge();

            const baseSize = 5 + Math.floor(drowsinessLevel / 2) + Math.min(currentStage - 1, 3);
            gridCols = baseSize % 2 === 0 ? baseSize + 1 : baseSize;
            gridRows = gridCols;

            cellSize = Math.floor(360 / gridCols);
            canvas.width = gridCols * cellSize;
            canvas.height = gridRows * cellSize;

            generateMaze(gridCols, gridRows);

            player = { x: 0, y: 0 };
            goal = { x: gridCols - 1, y: gridRows - 1 };

            // Stage 1: 평화 모드 (괴물 없음) / Stage 2+: 스테이지별 괴물 수 증가
            monsters = [];
            if (currentStage > 1) {
                const monsterCount = (currentStage - 1) * 2;
                for (let i = 0; i < monsterCount; i++) {
                    let mx, my;
                    do {
                        mx = Math.floor(Math.random() * gridCols);
                        my = Math.floor(Math.random() * gridRows);
                    } while ((mx === 0 && my === 0) || (mx === goal.x && my === goal.y) || maze[my][mx] === 1);

                    monsters.push({ x: mx, y: my });
                }
            }

            if (currentItem === 'bomb') {
                triggerBombEffect();
            }

            document.getElementById('stageText').innerText = `STAGE ${currentStage}`;
            document.getElementById('resultOverlay').style.display = 'none';

            timeLeft = 10.0;
            isPlaying = true;

            clearInterval(gameTimer);
            gameTimer = setInterval(updateTimer, 100);

            draw();
        }

        function updateItemBadge() {
            const badgeEl = document.getElementById('itemBadge');
            if (currentItem === 'speed') badgeEl.innerText = "아이템: 👟 속도업";
            else if (currentItem === 'laser') badgeEl.innerText = "아이템: ⚡ 레이저";
            else if (currentItem === 'hammer') badgeEl.innerText = "아이템: 🔨 해머";
            else if (currentItem === 'bomb') badgeEl.innerText = "아이템: 💣 폭탄";
            else badgeEl.innerText = "아이템: 없음";
        }

        function generateMaze(cols, rows) {
            maze = Array.from({ length: rows }, () => Array(cols).fill(1));

            function walk(cx, cy) {
                maze[cy][cx] = 0;
                const dirs = [[0, -2], [0, 2], [-2, 0], [2, 0]].sort(() => Math.random() - 0.5);

                for (let [dx, dy] of dirs) {
                    const nx = cx + dx;
                    const ny = cy + dy;
                    if (nx >= 0 && nx < cols && ny >= 0 && ny < rows && maze[ny][nx] === 1) {
                        maze[cy + dy / 2][cx + dx / 2] = 0;
                        walk(nx, ny);
                    }
                }
            }
            walk(0, 0);
            maze[rows - 1][cols - 1] = 0;
        }

        function updateTimer() {
            if (!isPlaying) return;

            timeLeft -= 0.1;
            if (timeLeft <= 0) {
                timeLeft = 0;
                gameOver("⏱️ 시간 초과! 졸음 퇴치 실패...");
            }

            document.getElementById('timerText').innerText = `${timeLeft.toFixed(1)}s`;
            document.getElementById('timerBar').style.width = `${(timeLeft / 10) * 100}%`;

            if (currentStage > 1 && Math.floor(timeLeft * 10) % 4 === 0) {
                moveMonsters();
            }

            draw();
        }

        function moveMonsters() {
            const dirs = [[0, -1], [0, 1], [-1, 0], [1, 0]];
            monsters.forEach(m => {
                const [dx, dy] = dirs[Math.floor(Math.random() * 4)];
                const nx = m.x + dx;
                const ny = m.y + dy;
                if (nx >= 0 && nx < gridCols && ny >= 0 && ny < gridRows && maze[ny][nx] === 0) {
                    m.x = nx;
                    m.y = ny;
                }

                if (m.x === player.x && m.y === player.y) {
                    gameOver("👾 괴물과 충돌했습니다! 게임 오버!");
                }
            });
        }

        function movePlayer(dx, dy) {
            if (!isPlaying) return;

            // 👟 속도 아이템 선택 시 2칸 이동
            const step = currentItem === 'speed' ? 2 : 1;

            for (let i = 0; i < step; i++) {
                const nx = player.x + dx;
                const ny = player.y + dy;

                if (nx >= 0 && nx < gridCols && ny >= 0 && ny < gridRows && maze[ny][nx] === 0) {
                    player.x = nx;
                    player.y = ny;
                    playSound('move');

                    if (currentItem && currentItem !== 'speed' && monsters.length > 0) {
                        applyWeaponEffect();
                    }

                    for (let m of monsters) {
                        if (m.x === player.x && m.y === player.y) {
                            gameOver("👾 괴물과 충돌했습니다! 게임 오버!");
                            return;
                        }
                    }

                    if (player.x === goal.x && player.y === goal.y) {
                        clearStage();
                        return;
                    }
                }
            }
            draw();
        }

        function applyWeaponEffect() {
            monsters = monsters.filter(m => {
                const dist = Math.abs(m.x - player.x) + Math.abs(m.y - player.y);
                if (dist <= 1) {
                    playSound('item');
                    visualEffects.push({
                        x: m.x, y: m.y,
                        type: currentItem,
                        life: 12
                    });
                    return false;
                }
                return true;
            });
        }

        function triggerBombEffect() {
            playSound('item');
            monsters = monsters.filter(m => {
                const dist = Math.abs(m.x - player.x) + Math.abs(m.y - player.y);
                if (dist <= 3) {
                    visualEffects.push({ x: m.x, y: m.y, type: 'bomb', life: 15 });
                    return false;
                }
                return true;
            });
        }

        function clearStage() {
            isPlaying = false;
            stopBGM();
            clearInterval(gameTimer);
            playSound('clear');

            // 매판 새로 아이템 선택을 위해 초기화
            currentItem = null;
            document.getElementById('weaponModal').style.display = 'flex';
        }

        function gameOver(msg) {
            isPlaying = false;
            stopBGM();
            clearInterval(gameTimer);
            playSound('alarm');

            const overlay = document.getElementById('resultOverlay');
            const title = document.getElementById('resultTitle');
            const desc = document.getElementById('resultDesc');

            title.innerText = "GAME OVER";
            desc.innerText = msg;
            overlay.style.display = 'flex';
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Maze grid rendering
            for (let r = 0; r < gridRows; r++) {
                for (let c = 0; c < gridCols; c++) {
                    if (maze[r][c] === 1) {
                        ctx.fillStyle = "#1e293b";
                        ctx.fillRect(c * cellSize, r * cellSize, cellSize, cellSize);
                        ctx.strokeStyle = "#334155";
                        ctx.strokeRect(c * cellSize, r * cellSize, cellSize, cellSize);
                    } else {
                        ctx.fillStyle = "#0f172a";
                        ctx.fillRect(c * cellSize, r * cellSize, cellSize, cellSize);
                    }
                }
            }

            // Goal Exit
            ctx.fillStyle = "#10b981";
            ctx.beginPath();
            ctx.arc((goal.x + 0.5) * cellSize, (goal.y + 0.5) * cellSize, cellSize * 0.35, 0, Math.PI * 2);
            ctx.fill();

            // Item FX Particle effects
            visualEffects.forEach((fx, idx) => {
                ctx.fillStyle = fx.type === 'laser' ? "#38bdf8" : "#f43f5e";
                ctx.beginPath();
                ctx.arc((fx.x + 0.5) * cellSize, (fx.y + 0.5) * cellSize, (cellSize * fx.life) / 18, 0, Math.PI * 2);
                ctx.fill();
                fx.life--;
                if (fx.life <= 0) visualEffects.splice(idx, 1);
            });

            // Monsters
            monsters.forEach(m => {
                ctx.font = `${cellSize * 0.6}px sans-serif`;
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                ctx.fillText("👾", (m.x + 0.5) * cellSize, (m.y + 0.5) * cellSize);
            });

            // Player Icon
            let playerIcon = "😳";
            if (currentItem === 'speed') playerIcon = "👟";
            else if (currentItem === 'laser') playerIcon = "⚡";
            else if (currentItem === 'hammer') playerIcon = "🔨";
            else if (currentItem === 'bomb') playerIcon = "💣";

            ctx.font = `${cellSize * 0.6}px sans-serif`;
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(playerIcon, (player.x + 0.5) * cellSize, (player.y + 0.5) * cellSize);
        }

        // Controls
        window.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') movePlayer(0, -1);
            if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') movePlayer(0, 1);
            if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') movePlayer(-1, 0);
            if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') movePlayer(1, 0);
        });

        document.getElementById('btnUp').addEventListener('click', () => movePlayer(0, -1));
        document.getElementById('btnDown').addEventListener('click', () => movePlayer(0, 1));
        document.getElementById('btnLeft').addEventListener('click', () => movePlayer(-1, 0));
        document.getElementById('btnRight').addEventListener('click', () => movePlayer(1, 0));

        // Weapon item selection buttons
        document.querySelectorAll('.weapon-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                playSound('ui');
                currentItem = e.currentTarget.dataset.weapon;
                document.getElementById('weaponModal').style.display = 'none';
                currentStage++;
                startStage();
            });
        });

        document.getElementById('retryBtn').addEventListener('click', () => {
            playSound('ui');
            startStage();
        });
    </script>
</body>
</html>